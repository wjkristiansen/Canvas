{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canvaspkg-project.schema.json",
  "title": "CanvasPkg project manifest",
  "type": "object",
  "required": ["formatVersion", "name", "packages"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": ["name", "location"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
        "location": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" }
      }
    }
  }
}
